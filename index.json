{
  "version": 1,
  "templates": [
    {
      "id": "adminer",
      "name": "Adminer",
      "description": "Single-file database management for PostgreSQL, MySQL, SQLite and more.",
      "category": "database",
      "version": "1.0.0",
      "icon": "logo.svg",
      "links": {
        "website": "https://www.adminer.org",
        "source": "https://github.com/vrana/adminer"
      },
      "maintainers": [
        "pritthishnath"
      ],
      "variables": [
        {
          "key": "PRIMARY_DOMAIN",
          "generate": "subdomain",
          "expose": {
            "service": "adminer",
            "port": 8080
          }
        }
      ]
    },
    {
      "id": "code-server",
      "name": "code-server",
      "description": "VS Code in the browser, running on your own node.",
      "category": "application",
      "version": "1.0.0",
      "icon": "logo.svg",
      "links": {
        "website": "https://coder.com/docs/code-server",
        "source": "https://github.com/coder/code-server"
      },
      "maintainers": [
        "pritthishnath"
      ],
      "variables": [
        {
          "key": "EDITOR_PASSWORD",
          "generate": "password"
        },
        {
          "key": "PRIMARY_DOMAIN",
          "generate": "subdomain",
          "expose": {
            "service": "code-server",
            "port": 8443
          }
        }
      ]
    },
    {
      "id": "gitea",
